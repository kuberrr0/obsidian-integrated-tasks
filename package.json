    "esbuild": "^0.25.3",
    "moment": "^2.29.4",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "chrono-node": "^2.8.0"
  }
